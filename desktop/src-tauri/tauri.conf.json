{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Castcut",
  "mainBinaryName": "prompt-studio",
  "version": "../../package.json",
  "identifier": "app.promptstudio.desktop",
  "build": {
    "frontendDist": "../splash",
    "devUrl": "http://127.0.0.1:47832"
  },
  "app": {
    "windows": [
      {
        "title": "Castcut",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": ["resources/server"],
    "category": "GraphicsAndDesign",
    "shortDescription": "Prompt, queue, and gallery studio",
    "longDescription": "Castcut desktop app. Bundles the Next.js server and a Node runtime. Connect ComfyUI from Settings."
  }
}
