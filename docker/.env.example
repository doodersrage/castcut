# Castcut Docker settings — all optional. With no .env at all Castcut starts with sign-in on and
# asks for the admin account on the first visit (the one-time setup code is in
# `docker compose logs castcut`). To change a default, copy this to .env next to compose.yml;
# changes take effect on `docker compose up -d` (no rebuild needed). Needs Compose 2.24+.

# ── Where ComfyUI and the LLM are ───────────────────────────────────────────────
# host.docker.internal = the machine Docker runs on. ComfyUI there must listen beyond
# localhost (start it with --listen). Another machine: use its address, e.g. http://192.168.1.20:8188
COMFYUI_API_URL=http://host.docker.internal:8188
# Any OpenAI-compatible server: LM Studio http://host.docker.internal:1234/v1,
# Ollama http://host.docker.internal:11434/v1 (or http://ollama:11434/v1 with --profile ollama).
LLM_API_BASE_URL=http://host.docker.internal:1234/v1
LLM_MODEL=
# Leave empty to pick a vision model from the LLM server's list.
LLM_VISION_MODEL=

# ── Sign-in ─────────────────────────────────────────────────────────────────────
# On by default. Leave the password empty to create the admin on the sign-in page; a password
# here is applied on start whenever it changes (a password changed in the app then sticks).
# The session secret is made on first start and kept in the data volume.
PROMPT_AUTH_ENABLED=true
PROMPT_ADMIN_USERNAME=admin
PROMPT_ADMIN_PASSWORD=

# ── Who can open it ─────────────────────────────────────────────────────────────
# 0.0.0.0 = any machine on your network (sign-in required above).
# 127.0.0.1 = only this machine; then sign-in may be off (PROMPT_AUTH_ENABLED=false).
CASTCUT_BIND=0.0.0.0
CASTCUT_PORT=47832

# ── Behind a reverse proxy (usually nothing to set) ─────────────────────────────
# A proxy that sends X-Forwarded-Host (nginx: proxy_set_header X-Forwarded-Host $host; Caddy and
# Traefik do by default) needs nothing here. Otherwise list the public name, e.g. castcut.example.com.
PROMPT_TRUSTED_HOSTS=
# The proxy's X-Real-IP / X-Forwarded-For are used when sent; false ignores them.
TRUST_PROXY_HEADERS=
# Emails (invites, password resets) link to the address the admin last signed in at; set this
# only to pin another, e.g. https://castcut.example.com
PROMPT_API_URL=
# Restoring a Pictures backup uploads 32 MB pieces: allow ≥ 40 MB request bodies on the proxy
# (nginx: client_max_body_size 40m;).

# ── Optional ────────────────────────────────────────────────────────────────────
# Scripts and ComfyUI nodes: use a personal key from Profile → API keys. This shared service
# token is only for setups that can't (openssl rand -hex 24).
PROMPT_API_TOKEN=
# Adult generator and Roleplay heat levels.
PROMPT_NSFW_GENERATOR_ENABLED=false
# Anything else from docs/configuration.md can go here too.
