# Castcut Docker settings. Copy to .env next to compose.yml and edit; then
#   docker compose up -d --build
# Changes take effect on `docker compose up -d` (no rebuild needed).

# ── Where ComfyUI and the LLM are ───────────────────────────────────────────────
# host.docker.internal = the machine Docker runs on. ComfyUI there must listen beyond
# localhost (start it with --listen). Another machine: use its address, e.g. http://192.168.1.20:8188
COMFYUI_API_URL=http://host.docker.internal:8188
# Any OpenAI-compatible server: LM Studio http://host.docker.internal:1234/v1,
# Ollama http://host.docker.internal:11434/v1 (or http://ollama:11434/v1 with --profile ollama).
LLM_API_BASE_URL=http://host.docker.internal:1234/v1
LLM_MODEL=
# Leave empty to pick a vision model from the LLM server's list.
LLM_VISION_MODEL=

# ── Sign-in ─────────────────────────────────────────────────────────────────────
# Required when Castcut is reachable from other machines (the default). Make a secret with:
#   openssl rand -hex 32
PROMPT_AUTH_ENABLED=true
PROMPT_ADMIN_USERNAME=admin
PROMPT_ADMIN_PASSWORD=
PROMPT_SESSION_SECRET=

# ── Who can open it ─────────────────────────────────────────────────────────────
# 0.0.0.0 = any machine on your network (sign-in required above).
# 127.0.0.1 = only this machine; then sign-in may be off (PROMPT_AUTH_ENABLED=false).
CASTCUT_BIND=0.0.0.0
CASTCUT_PORT=47832

# ── Behind a reverse proxy (leave empty otherwise) ──────────────────────────────
# The public name you open it at, e.g. castcut.example.com, or sign-in says Unauthorized.
PROMPT_TRUSTED_HOSTS=
# true when the proxy sets X-Real-IP / X-Forwarded-For (per-client rate limits).
TRUST_PROXY_HEADERS=false
# Public origin for invite / password-reset emails, e.g. https://castcut.example.com
PROMPT_API_URL=
# Restoring a Pictures backup uploads 32 MB pieces: allow ≥ 40 MB request bodies on the proxy
# (nginx: client_max_body_size 40m;).

# ── Optional ────────────────────────────────────────────────────────────────────
# Token for ComfyUI custom nodes / scripts calling the API (openssl rand -hex 24).
PROMPT_API_TOKEN=
# Adult generator and Roleplay heat levels.
PROMPT_NSFW_GENERATOR_ENABLED=false
# Anything else from docs/configuration.md can go here too.
